@model List<AuditLog>
@{
    ViewData["Title"] = "Audit Log";
}
<h3><i class="bi bi-shield-check"></i> Audit Log (last 300 entries)</h3>

<div class="card p-3 mt-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr>
            </thead>
            <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.LogDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm:ss")</td>
                    <td>@log.Username</td>
                    <td><span class="badge bg-secondary">@log.Action</span></td>
                    <td>@log.EntityName @(log.EntityId.HasValue ? $"#{log.EntityId}" : "")</td>
                    <td>@log.Details</td>
                    <td>@log.IPAddress</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
