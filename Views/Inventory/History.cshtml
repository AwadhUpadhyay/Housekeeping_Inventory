@model List<StockTransaction>
@{
    var item = (InventoryItem)ViewBag.Item;
    ViewData["Title"] = "Stock History";
}
<h3><i class="bi bi-clock-history"></i> Stock History — @item.ItemName</h3>
<p class="text-muted">SKU: @item.SKU &nbsp;|&nbsp; Current Available Stock: <strong>@item.AvailableStock</strong></p>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Date</th><th>Type</th><th>Qty</th><th>Previous</th><th>New</th><th>Remarks</th><th>Performed By</th></tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">No stock transactions yet for this item.</td></tr>
            }
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.TransactionDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                    <td><span class="badge bg-success">@s.TransactionType</span></td>
                    <td>+@s.Quantity</td>
                    <td>@s.PreviousStock</td>
                    <td>@s.NewStock</td>
                    <td>@s.Remarks</td>
                    <td>@s.PerformedByName</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<a asp-action="Index" class="btn btn-outline-secondary mt-3">Back to Inventory</a>
