@model RunningInventoryIssueViewModel

@{
    ViewData["Title"] = "Issue Item";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3>
            <i class="bi bi-box-arrow-up"></i> Issue Item
        </h3>
        <div class="text-muted">
            Transfer running inventory from one location to another.
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="card">
    <div class="card-body">

        <form asp-action="IssueItem" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="ItemName" class="form-label">
                        Item <span class="text-danger">*</span>
                    </label>

                    <select asp-for="ItemName"
                            class="form-select"
                            required>
                        <option value="">-- Select Item --</option>

                        @foreach (var item in Model.Items)
                        {
                            <option value="@item.ItemName">
                                @item.ItemName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="ItemName"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Quantity" class="form-label">
                        Quantity <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Quantity"
                           type="number"
                           min="1"
                           class="form-control"
                           required />

                    <span asp-validation-for="Quantity"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FromLocation" class="form-label">
                        From <span class="text-danger">*</span>
                    </label>

                    <select asp-for="FromLocation"
                            class="form-select"
                            id="fromLocation"
                            required>
                        <option value="">-- Select From Location --</option>

                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location">
                                @location
                            </option>
                        }
                    </select>

                    <span asp-validation-for="FromLocation"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ToLocation" class="form-label">
                        To <span class="text-danger">*</span>
                    </label>

                    <select asp-for="ToLocation"
                            class="form-select"
                            id="toLocation"
                            required>
                        <option value="">-- Select To Location --</option>

                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location">
                                @location
                            </option>
                        }
                    </select>

                    <span asp-validation-for="ToLocation"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-left-right"></i>
                    Transfer Item
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const from = document.getElementById("fromLocation");
            const to = document.getElementById("toLocation");

            function updateToLocations() {

                const selectedFrom = from.value;

                Array.from(to.options).forEach(function (option) {

                    if (!option.value) {
                        option.hidden = false;
                        return;
                    }

                    option.hidden =
                        option.value === selectedFrom;
                });

                if (to.value === selectedFrom) {
                    to.value = "";
                }
            }

            from.addEventListener("change", updateToLocations);

            updateToLocations();
        });
    </script>
}