@model List<IssueTransaction>
@{
    ViewData["Title"] = "Issue History";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-list-ul"></i> Recent Issue History (last 50)</h3>
    </div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th><th>Item</th><th>Qty</th><th>Issued To</th><th>Room</th>
                    <th>Department</th><th>Purpose</th><th>Issued By</th><th>Authorized By</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center text-muted">No issue transactions recorded yet.</td></tr>
            }
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.IssueDate.ToString("dd-MMM-yyyy HH:mm")</td>
                    <td>@i.ItemName</td>
                    <td>@i.Quantity</td>
                    <td>@i.IssuedToName</td>
                    <td>@i.RoomNumber</td>
                    <td>@i.Department</td>
                    <td>@i.Purpose</td>
                    <td>@i.IssuedByName</td>
                    <td>@i.AuthorizedByName</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
