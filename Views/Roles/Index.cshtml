@model List<Role>
@{
    ViewData["Title"] = "Roles";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-person-badge"></i> Roles</h3>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-circle"></i> Add Role</a>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Role Name</th><th>Description</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.RoleName</td>
                    <td>@r.Description</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">New roles appear automatically in the Role dropdown when creating or editing a user.</p>
