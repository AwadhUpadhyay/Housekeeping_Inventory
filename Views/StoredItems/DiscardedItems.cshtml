@model IEnumerable<HotelHousekeepingApp.Controllers.StoredItemsController.DiscardedItemViewModel>

@{
    ViewData["Title"] = "Discarded Items";

    var records = Model?.ToList()
        ?? new List<HotelHousekeepingApp.Controllers.StoredItemsController.DiscardedItemViewModel>();

    var totalTransactions = records.Count;
    var totalQuantity = records.Sum(x => x.Quantity);
    var totalValue = records.Sum(x => x.Amount);
    var withAttachment = records.Count(x => x.HasAttachment);

    var items =
        ViewBag.Items as List<HotelHousekeepingApp.Models.StoredItem>
        ?? new List<HotelHousekeepingApp.Models.StoredItem>();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1 text-danger">
                <i class="bi bi-trash"></i>
                Discarded Items Dashboard
            </h2>

            <p class="text-muted mb-0">
                View discarded housekeeping items and their supporting attachments.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="DiscardReport"
               asp-route-fromDate="@ViewBag.FromDate"
               asp-route-toDate="@ViewBag.ToDate"
               asp-route-itemId="@ViewBag.ItemId"
               class="btn btn-danger"
               target="_blank">
                <i class="bi bi-file-earmark-text"></i>
                Generate Report
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

        </div>

    </div>

    <!-- FILTERS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white">
            <strong>
                <i class="bi bi-funnel"></i>
                Filter Discarded Items
            </strong>
        </div>

        <div class="card-body">

            <form method="get"
                  asp-action="DiscardedItems"
                  class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        From Date
                    </label>

                    <input type="date"
                           name="fromDate"
                           value="@ViewBag.FromDate"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        To Date
                    </label>

                    <input type="date"
                           name="toDate"
                           value="@ViewBag.ToDate"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Item
                    </label>

                    <select name="itemId"
                            class="form-select">

                        <option value="">All Items</option>

                        @foreach (var item in items)
                        {
                            <option value="@item.StoredItemID"
                                    selected="@(ViewBag.ItemId?.ToString() == item.StoredItemID.ToString())">
                                @item.ItemName
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary flex-fill">
                        <i class="bi bi-search"></i>
                        Apply
                    </button>

                    <a asp-action="DiscardedItems"
                       class="btn btn-outline-secondary"
                       title="Clear filters">
                        <i class="bi bi-x-lg"></i>
                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">DISCARD TRANSACTIONS</small>
                    <div class="fs-3 fw-bold text-danger">
                        @totalTransactions
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">TOTAL QUANTITY</small>
                    <div class="fs-3 fw-bold">
                        @totalQuantity
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">TOTAL VALUE</small>
                    <div class="fs-3 fw-bold">
                        ₹@totalValue.ToString("N2")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">WITH ATTACHMENT</small>
                    <div class="fs-3 fw-bold text-primary">
                        @withAttachment
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-danger text-white">
            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-trash3"></i>
                    Discarded Item Records
                </h5>

                <span class="badge bg-light text-dark">
                    @totalTransactions Records
                </span>

            </div>
        </div>

        <div class="card-body p-0">

            @if (!records.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-trash fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No Discarded Items Found
                    </h5>

                    <p class="text-muted">
                        No discarded transactions match the selected filters.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Date & Time</th>
                                <th>Item</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Amount</th>
                                <th>Previous</th>
                                <th>Remaining</th>
                                <th>Remarks</th>
                                <th>Discarded By</th>
                                <th>Evidence</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var record in records)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @record.TransactionDate.ToString("dd-MMM-yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @record.TransactionDate.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @record.ItemName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(record.Category))
                                        {
                                            <small class="text-muted">
                                                @record.Category
                                            </small>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <strong class="text-danger">
                                            @record.Quantity
                                        </strong>
                                    </td>

                                    <td class="text-end">
                                        ₹@record.Rate.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        <strong>
                                            ₹@record.Amount.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @record.PreviousStock
                                    </td>

                                    <td>
                                        <strong>
                                            @record.NewStock
                                        </strong>
                                    </td>

                                    <td style="min-width:180px;">
                                        @if (string.IsNullOrWhiteSpace(record.Remarks))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            @record.Remarks
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(record.PerformedByName)
                                            ? $"User #{record.PerformedByUserId}"
                                            : record.PerformedByName)
                                    </td>

                                    <!-- EVIDENCE -->
                                    <td style="min-width:150px;">

                                        @if (record.HasAttachment)
                                        {
                                            if (record.AttachmentContentType?.StartsWith("image/") == true)
                                            {
                                                <!-- ONLY VIEW IMAGE BUTTON -->
                                                <a href="@record.AttachmentPath"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-primary">

                                                    <i class="bi bi-image"></i>
                                                    View Image

                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@record.AttachmentPath"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-danger">

                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                    View PDF

                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">
                                                No attachment
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>