@model IEnumerable<HotelHousekeepingApp.Models.StoredItem>

@{
    ViewData["Title"] = "Stock Inventory";

    var itemList = Model?.ToList()
                   ?? new List<HotelHousekeepingApp.Models.StoredItem>();

    var activeItems = itemList.Count(x => x.IsActive);
    var lowStockItems = itemList.Count(x =>
        x.IsActive && x.AvailableStock <= x.MinStockLevel);

    var totalStock = itemList
        .Where(x => x.IsActive)
        .Sum(x => x.AvailableStock);
}

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam"></i>
                Stock Inventory
            </h2>

            <p class="text-muted mb-0">
                Housekeeping inventory master and stock overview.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="NewEntry"
               class="btn btn-success">
                <i class="bi bi-plus-circle"></i>
                New Entry
            </a>

            <a asp-action="DiscardedItems"
               class="btn btn-outline-danger">
                <i class="bi bi-trash3"></i>
                Discarded Items
            </a>

            <a asp-action="DiscardReport"
               class="btn btn-outline-secondary">
                <i class="bi bi-file-earmark-pdf"></i>
                Discard Report
            </a>

            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-box-seam"></i>
                Create Item Master
            </a>

        </div>

    </div>


    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <small class="text-muted">
                                Active Items
                            </small>

                            <h3 class="fw-bold mb-0">
                                @activeItems
                            </h3>
                        </div>

                        <div class="fs-1 text-primary">
                            <i class="bi bi-box-seam"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <small class="text-muted">
                                Low Stock
                            </small>

                            <h3 class="fw-bold mb-0 text-danger">
                                @lowStockItems
                            </h3>
                        </div>

                        <div class="fs-1 text-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- INVENTORY TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-list-ul"></i>
                    Stock Inventory
                </h5>

                <span class="badge bg-primary">
                    @activeItems Active
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!itemList.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-box-seam display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No inventory items found
                    </h5>

                    <p class="text-muted">
                        Create your first housekeeping inventory item.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>
                        Create Item Master

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width:70px;">
                                    #
                                </th>

                                <th>
                                    Item
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Unit
                                </th>

                                <th class="text-end">
                                    Rate
                                </th>

                                <th class="text-end">
                                    Current Stock
                                </th>

                                <th class="text-end">
                                    Minimum
                                </th>

                                <th class="text-center">
                                    Status
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var rowNumber = 1;
                            }

                            @foreach (var item in itemList)
                            {
                                var isLowStock =
                                    item.IsActive &&
                                    item.AvailableStock <= item.MinStockLevel;

                                <tr>

                                    <td>
                                        @rowNumber
                                    </td>


                                    <td>

                                        <div class="fw-semibold">
                                            @item.ItemName
                                        </div>

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Category))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @item.Category
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Unit)
                                            ? "—"
                                            : item.Unit)
                                    </td>


                                    <td class="text-end">
                                        ₹@item.Rate.ToString("N2")
                                    </td>


                                    <td class="text-end">

                                        <span class="fw-bold @(isLowStock
                                            ? "text-danger"
                                            : "text-success")">

                                            @item.AvailableStock

                                        </span>

                                    </td>


                                    <td class="text-end">
                                        @item.MinStockLevel
                                    </td>


                                    <td class="text-center">

                                        @if (!item.IsActive)
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                        else if (isLowStock)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-exclamation-triangle"></i>
                                                Low Stock

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }

                                    </td>


                                    <td class="text-center">

                                        <div class="btn-group">

                                            @if (item.IsActive)
                                            {
                                                <a asp-action="NewEntry"
                                                   asp-route-storedItemId="@item.StoredItemID"
                                                   class="btn btn-sm btn-primary"
                                                   title="New Stock Entry">

                                                    <i class="bi bi-plus-lg"></i>

                                                </a>
                                            }


                                            <a asp-action="History"
                                               asp-route-id="@item.StoredItemID"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="View History">

                                                <i class="bi bi-clock-history"></i>

                                            </a>


                                            <a asp-action="DiscardedItems"
                                               asp-route-itemId="@item.StoredItemID"
                                               class="btn btn-sm btn-outline-danger"
                                               title="View Discarded Items">

                                                <i class="bi bi-trash-fill"
                                                   style="color: grey;"></i>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-id="@item.StoredItemID"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Item">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                rowNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         INVENTORY ENTRY WORKFLOW
         ADMIN + IT ONLY
         ===================================================== -->

    @if (User.IsInRole("Admin") || User.IsInRole("IT"))
    {
        <div class="alert alert-info mt-4">

            <div class="d-flex">

                <div class="me-3">
                    <i class="bi bi-info-circle fs-4"></i>
                </div>

                <div>

                    <strong>
                        Inventory Entry Workflow
                    </strong>

                    <ul class="mb-0 mt-2">

                        <li>
                            <strong>New Receiving</strong>
                            increases stock and records the receiving rate.
                        </li>

                        <li>
                            <strong>Discarded</strong>
                            decreases stock and can have an optional JPG, PNG or PDF attachment.
                        </li>

                        <li>
                            <strong>Missing</strong>
                            decreases stock using the applicable item rate.
                        </li>

                        <li>
                            Stock cannot become negative.
                        </li>

                        <li>
                            All transactions are recorded in transaction history.
                        </li>

                    </ul>

                </div>

            </div>

        </div>
    }

</div>